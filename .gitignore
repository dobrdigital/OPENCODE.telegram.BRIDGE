# ── Секреты ──────────────────────────────────────────────────────────
# ВНИМАНИЕ: в .gitignore символ # действует только в начале строки.
# Хвостовых комментариев не существует - "config.toml  # токен" будет
# искать файл с таким именем целиком и не исключит ничего.
config.toml
config.local.toml
service.json
token.local.txt
*.lock

# ── Логи и состояние ─────────────────────────────────────────────────
*.log
*.err.log
*.out
run/
sessions/
crons/
backup/
projects/
agent-prompts/
timers/

# ── Кэш ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/

# Инструменты пишут кэш туда, где оказались запущены. Один запуск из корня
# репозитория - и в первый коммит попали pip/cache и ModuleAnalysisCache.
pip/
Microsoft/
nul
Thumbs.db

# Артефакты автотестов
autotest*.log
cc-stt-selftest/

# ── Редакторы и ОС ──────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store